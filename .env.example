# Copy this file to .env and fill in the values.
# Never commit .env.

# Supabase connection
SUPABASE_HOST=
SUPABASE_PROJECT_REF=
DATABASE_PASSWORD=
DATABASE_URL=

# JWT verification (required — app refuses to start if blank)
# Local:  use http://127.0.0.1:54321/auth/v1/.well-known/jwks.json and http://127.0.0.1:54321/auth/v1
# Remote: replace <ref> with your project ref from the Supabase dashboard
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<ref>.supabase.co/auth/v1

# Supabase Storage (closeout photos) — URL and key must point at the same
# stack. Leave both unset for local dev (defaults target 127.0.0.1:54321);
# remote deploys set BOTH (key = the project's service role key, bypasses RLS).
#STORAGE_URL=https://<ref>.supabase.co/storage/v1
#STORAGE_SERVICE_KEY=

# Anthropic API
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# App
SECRET_KEY=
