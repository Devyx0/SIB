# Copy this file to .env and fill in the blanks.
# Never commit .env — it holds real secrets (API keys, remote DB password).
#
# Local-dev quickstart (everything targets the local Supabase stack):
#   1. supabase start           (starts DB on 54322, API on 54321)
#   2. supabase db reset        (applies supabase/migrations/)
#   3. cp .env.example .env     then fill ANTHROPIC_API_KEY + DEV_SEED_PASSWORD
#   4. python scripts/seed_dev_users.py   (creates the 4 dev accounts)
#   5. .venv/bin/uvicorn backend.main:app --reload
# The values already filled in below are the PUBLIC supabase-local defaults —
# identical on every machine, not secrets.

# ── Required — app refuses to start if blank ─────────────────────────────────
# JWT verification. Local stack values; for a remote deploy replace with
# https://<ref>.supabase.co/auth/v1/... and the project's JWT secret.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1

# Anthropic — required at startup (triage). Get your own key or ask the team.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Password for the 4 seeded local accounts (coordinator@sib.local, etc.).
# Pick your own — it only exists in YOUR local auth DB.
DEV_SEED_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────
# DB target: local (default, supabase start) or remote.
#DB_TARGET=local

# Weather escalation (SoW 3.4) — draft feature, off by default.
#WEATHER_ESCALATION_ENABLED=true

# Browser origins allowed to call the API (comma-separated). Required for
# Railway when the frontend is on a different host than the backend.
#CORS_ORIGINS=https://frontend-production-7232e.up.railway.app

# ── Remote Supabase (only when DB_TARGET=remote; leave blank for local dev) ──
#SUPABASE_HOST=
#SUPABASE_PROJECT_REF=
#DATABASE_PASSWORD=
#DATABASE_URL=
#SECRET_KEY=

# Supabase Storage (closeout photos) — URL and key must point at the same
# stack. Leave both unset for local dev (defaults target 127.0.0.1:54321);
# remote deploys set BOTH (key = the project's service role key, bypasses RLS).
#STORAGE_URL=https://<ref>.supabase.co/storage/v1
#STORAGE_SERVICE_KEY=

# AssemblyAI speech-to-text (dictation). Server-side only — never in apps/web.
ASSEMBLYAI_API_KEY=
