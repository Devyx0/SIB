//////////////////// ENUMS ////////////////////

// DBML does not support type-level comments for enums; per-value notes are used instead.
enum urgency_tier {
  AJD [note: "aujourd'hui — urgent, handle today (guide rule 28). Uppercase form in source data."]
  ajd [note: "data-quality artefact from source ingestion; normalised to AJD by triage service"]
  none [note: "legacy ingestion artefact; output contract uses JSON null for non-urgent, not this value"]
}

enum complexity_tier {
  C1 [note: "N'importe qui — no tool or skill required; natural pool for delegation to tenant. Guide §7a."]
  C2 [note: "Ouvrier — standard toolbox, limited training sufficient. Label changed from 'de base' on 2026-07-12 (former label judged pejorative). Guide §7a."]
  C3 [note: "Ouvrier expérimenté / spécialité — diagnosis required, building system knowledge, real experience needed. Guide §7a."]
  C4 [note: "Sous-traitant / expertise externe — Newtech, Fortin, roofing, elevator, enamelling, extermination, anything requiring a quote. Guide §7a."]
}

enum congestion_level {
  N1 [note: "Au-dessus de nos affaires — fast response, minimal delegation. Guide §7b."]
  N2 [note: "Niveau courant — normal pace. Guide §7b."]
  N3 [note: "En retard — negotiate deferred scheduling for non-urgent calls; actively offer delegation. Guide §7b."]
  N4 [note: "Très en retard — maximum deferral; paid delegation accepted readily. Guide §7b."]
  N5 [note: "Critique — everything that can wait waits; delegation and subcontracting without hesitation. Guide §7b."]
}

enum report_status {
  CANNOT_WAIT       [note: "inform supervisor immediately (guide §9 RAPPORT SUPERVISEUR)"]
  SUPERVISOR_DISCRETION [note: "inform supervisor; timing at their discretion"]
  CAN_WAIT_SHORT_TERM   [note: "flag for next supervisor touchpoint"]
  CAN_WAIT              [note: "no near-term supervisor action required"]
  NOT_APPLICABLE        [note: "report obligation does not apply to this call type"]
}

enum delegable_status {
  YES
  NO
  CONDITIONAL
}

enum time_estimate_bucket {
  UNDER_30_MIN  [note: "guide: <30 min"]
  MIN30_TO_1H   [note: "guide: 30 min–1h"]
  H1_TO_2H      [note: "guide: 1h–2h"]
  H2_TO_4H      [note: "no direct guide equivalent — guide jumps from 1h–2h to demi-journée; retained as intermediate bucket"]
  HALF_DAY_PLUS [note: "guide: demi-journée ou journée+"]
  TBD_ON_SITE   [note: "guide: soumission requise (quote required before estimating) — enum name is misleading"]
}


enum vendor_scope {
  portfolio_wide
  building_specific
}

enum shift_type {
  ouverture
  fermeture
  terrain
  off
  vacances
  garde_urgence
}

enum move_reason {
  lease_end
  lease_assignment
  eviction
}

enum key_method {
  remise_directe
  boite_a_cle
  bureau
}

enum intercom_status {
  to_do
  done
  call_placed
}

enum move_type {
  depart
  arrivee
}

enum time_slot {
  slot_8_11
  slot_11_14
  slot_14_17
  slot_17_20
}

enum loan_status {
  RETIRE
  ACHAT
}

enum task_item_type {
  jeter
  menage
  peinture
  plancher
  comptoir
  armoires
  ajout_electros
}

enum payment_type {
  coin
  card
  both
}

enum pay_rule_type {
  overage
  percentage
  rental
}

enum camera_platform {
  hik_connect
  cloud_generic
  ubox
  blink
}

enum access_status_enum {
  Oui_Paradox
  Oui_Akuvox
  Oui
  Non
  Installation_prevue
}

// NEW — tenancy_record.capacite. Source: live map, Tenant deep-view —
// "what capacity they were in — named on the lease, an added occupant,
// or someone who took it over".
enum tenancy_capacity {
  named_on_lease
  added_occupant
  took_over
}

// NEW — entrance.access_method. Source: live map, Building deep-view —
// "how it opens — key, fob, keypad or intercom release".
enum entrance_access_method {
  key
  fob
  keypad
  intercom_release
}

// NEW — equipment.equipment_type. Source: live map, Building deep-view —
// "furnaces, boilers, central heat pumps, elevators and freight elevators,
// the pool, barbecues and terraces".
// heating — heating circuit from Boilers source (split ingestion from "Chauffage" column block)
// dhw     — domestic hot water circuit from Boilers source (split ingestion from "ECD" = Eau Chaude Domestique column block)
enum equipment_type {
  furnace
  boiler
  heat_pump
  elevator
  freight_elevator
  pool
  barbecue
  terrace
  heating  // heating circuit; used when splitting one Boilers source row into 2 equipment rows
  dhw      // domestic hot water circuit; paired with heating for split-row ingestion
  other
}

// NEW — service_contract.category. Source: live map, Building/Vendor
// deep-views — "snow, lawn, pool, pest, fire, elevators, telecom".
// waste — added for Container Rental contracts; does not fit any of the original 7 categories.
enum service_contract_category {
  snow
  lawn
  pool
  pest
  fire
  elevator
  telecom
  waste          // Container Rental — confirmed does not fit the original 7 categories
  snow_parking   // Stationnement déneigement (parking lot snow removal)
  snow_pedestrian // Piétonnier déneigement (pedestrian path snow removal)
}

// NEW — cleaning_task_checklist.format_type. Source: Ménage source files showed
// four distinct formats in practice: fully structured rows (element/freq/hours/total),
// rotating day schedules, single freetext lines, and unstructured freetext blocks.
enum checklist_format_type {
  structured   // element / frequency_per_week / hours_per_visit / total all populated
  day_rotation // tasks listed as Day 1 / Day 2 rotation patterns
  single_line  // one-line task description, no structured columns applicable
  freetext     // multi-line unstructured block; use raw_content column
}

// NEW — service_visit.visit_type. Source: live map, Building deep-view —
// "the annual fire inspection, monthly elevator service, seasonal boiler
// shutdown and restart".
enum service_visit_type {
  fire_inspection
  elevator_service
  boiler_shutdown
  boiler_restart
  other
}

enum employment_type {
  staff
  contractor_company
  unknown
}

enum source_confidence {
  documented
  inferred_from_calendar
}

// NEW (2026-10-09) — Triage schema additions (SoW Milestone 1, Step 1)
// DBML does not support type-level comments for enums; per-value notes used instead.
// Auto-retry loop must include ONLY triage_pending and triage_failed.
// triage_clarify is explicitly excluded — human input required, not a transient error.
enum request_status {
  intake_received  [note: 'Request landed; waiting for next triage run']
  triage_pending   [note: 'Acquired by triage service (triage_started_at set); other workers skip. Rows stuck > 10 min = abandoned lock']
  triage_clarify   [note: 'BLOCKED — ambiguous unit or unresolvable address. Coordinator must resolve. NEVER auto-retry.']
  triage_proposal  [note: 'Model output ready, passed validation; coordinator review pending before dispatch board visibility']
  triage_failed    [note: 'All retries exhausted (API error or repeated gate rejection). Auto-retry permitted after manual reset.']
  triaged          [note: 'Coordinator accepted proposal; on the dispatch board. assigned_employee_id null = unassigned; set = assigned. No separate status for sub-states.']
  en_route         [note: 'Worker confirmed and heading to site; triggers tenant SMS']
  closed           [note: 'Work complete. All rows before 2026-10-09 carry this as a backfill sentinel — does not mean work was verified.']
}

//////////////////// STATIC / REFERENCE TABLES ////////////////////

Table project {
  project_id integer [primary key]
  nom_unique_projet varchar
  adresse_quickbooks varchar
  // NEW (2026-10-06) — Table Fondamentale Phase 1
  accounting_project_number varchar   // TF: col 3 "Numero comptable de Projet" (e.g. "162")
  // NEW (2026-10-07) — Table Fondamentale finance cluster (grain confirmed project-level)
  purchase_price   numeric   // TF: col 14 "Prix d'achat"; NULL for Marais (no source) and Chamonix (N/A in TF)
  acquisition_date date      // TF: col 15 "Date d'acquisition"; NULL for Marais only
  quickbooks_class varchar   // TF: col 5  "Nom de Classe pour Quickbooks"; NULL for Chamonix+Marais
}

Table sector {
  sector_id integer [primary key]
  territoire varchar // broader geographic region (e.g. "QUÉBEC-EST")
  color_code varchar
}

Table building {
  building_id integer [primary key]
  project_id integer [ref: > project.project_id]
  sector_id integer [ref: > sector.sector_id]
  adresse varchar
  ville varchar
  code_postal varchar
  annee_construction varchar
  nb_etages varchar
  nb_logements varchar
  ascenseur boolean
  piscine boolean
  sauna boolean
  gym boolean
  chauffage varchar
  systeme_incendie varchar
  boite_a_cle_ext varchar // NOTE: kept for backward compat; new key-box detail
                          // lives on building_key_box, which will eventually
                          // hang off entrance rather than building directly.
  boite_a_cle_int varchar
  raw_fiche_technique json
  // Source: Fire Protection RÉF. tab. NOT unique — 31 A-codes span 2+ buildings
  // (fire-protection uses project-level grain; our table is building-level).
  // Nullable: 4 buildings have no A-code (2 terrain parcels + Corail + Marais).
  legacy_code varchar

  // NEW (2026-09-26) — Source: Table Fondamentale (ingest_building.py Phase 1 write).
  // These columns carry the TF+FT attribute data approved for ingestion.
  // All nullable — TF has partial coverage (~94-96% on most columns).
  sib_territory varchar           // TF: sib_territory — SIB geographic territory label (e.g. "QUÉBEC-EST")
  furnished varchar               // TF: furnished — furnishing status ("Fully Furnished", "Unfurnished", etc.)
  building_structure varchar      // TF: building_structure — construction type ("Wood Frame", "Concrete", etc.)
  nb_elevateurs integer           // TF: num_elevators — elevator count (integer; paired with ascenseur bool)
  num_service_elevators integer   // TF: num_service_elevators — freight/service elevator count
  internet varchar                // TF: internet — connectivity type ("Yes (Wi-Fi only)", "No", etc.)
  terrasse_commune boolean        // TF: common_terrace
  num_bbqs integer                // TF: num_bbqs — BBQ unit count on common terrace
  coworking_space boolean         // TF: coworking_space
  reception_loft boolean          // TF: reception_loft
  chauffage_details text          // TF: heating_details — free-text heating description
  chauffe_eau varchar             // TF: hot_water_mode — domestic hot water source
  individual_heat_pumps boolean   // TF: individual_heat_pumps — per-unit heat pumps present
  heat_pump_details text          // TF: heat_pump_details — free-text heat pump description

  // NEW (2026-10-06) — Table Fondamentale Phase 1 (live sheet)
  nb_units_total integer          // TF col 7: total rentable units
  nb_units_residential integer    // TF col 8: residential units only
  actif_inactif varchar           // TF col 13: "Actif" or "Inactif"
  municipality varchar            // TF col 16: city/municipality name
  property_type varchar           // TF col 17: e.g. "Multilogement", "Duplex ou triplex"
  dogs_allowed boolean            // TF col 52: "Droit aux chiens" (Oui→true, Non→false)
  web_building_name varchar       // TF col 54: short display name for website
  web_slug varchar                // TF col 55: URL slug for website
}

// NEW — Source: live map, Building deep-view: "Each front door: civic
// number, street, postal code, and how it opens... A building on a corner
// legitimately has two entrances, on two streets, sometimes with two
// postal codes, and the intercom and key box now hang off the right door."
// No source file exists yet. Until real per-entrance data is captured,
// ingestion should create exactly one synthetic entrance per building
// (copying building.adresse/ville/code_postal) so building_intercom and
// building_key_box always have somewhere valid to point.
Table entrance {
  entrance_id integer [primary key]
  building_id integer [ref: > building.building_id]
  civic_number varchar
  street varchar
  postal_code varchar
  access_method entrance_access_method
  notes text
}

Table building_document {
  document_id integer [primary key]
  building_id integer [ref: > building.building_id]
  category varchar // elevator_contract / fire_protection / paint_spec / install_guide / plumbing_reference / other
  drive_file_id varchar
  title varchar
  url varchar
}

Table vendor_contact {
  vendor_id integer [primary key]
  trade varchar
  nom varchar
  telephone varchar
  notes text
}

Table building_vendor {
  building_id integer [ref: > building.building_id]
  vendor_id integer [ref: > vendor_contact.vendor_id]
  vendor_account_number varchar // confirmed NOT strictly 1:1, one account can cover multiple buildings
  notes text
}

Table vendor_category_exclusivity {
  exclusivity_id integer [primary key]
  vendor_id integer [ref: > vendor_contact.vendor_id]
  category_label varchar
  scope vendor_scope
  rule_code varchar // A0-A5
}

// NEW — Source: live map, Building & Vendor deep-views — "snow removal,
// lawn care, pool, pest control, fire protection, elevator service and
// telecom... one contract can cover several buildings." No source file
// exists yet (only unstructured year-by-year contract folders).
Table service_contract {
  contract_id integer [primary key]
  vendor_id integer [ref: > vendor_contact.vendor_id]
  category service_contract_category
  term_start date
  term_end date
  cost decimal
  renews boolean
  notes text
}

// NEW — junction, since one contract can legitimately cover several
// buildings (explicit in the live map, both for laundry-style and
// generic service contracts).
Table service_contract_building {
  contract_id integer [ref: > service_contract.contract_id]
  building_id integer [ref: > building.building_id]
}

// NEW — Source: live map, Building & Vendor deep-views — "every due-and-
// done service event: the annual fire inspection, monthly elevator
// service, seasonal boiler shutdown and restart — due date, what was
// actually done, the result, any deficiencies, when the next one falls."
// No source file exists yet: "Protection incendie folder exists but is
// empty" of STRUCTURED data — the folder itself holds ~106 real
// per-building subfolders of unstructured inspection PDFs, confirmed
// during our own Drive review, but nothing has been extracted into rows.
Table service_visit {
  visit_id integer [primary key]
  building_id integer [ref: > building.building_id]
  vendor_id integer [ref: > vendor_contact.vendor_id, note: 'nullable']
  equipment_id integer [ref: > equipment.equipment_id, note: 'nullable']
  visit_type service_visit_type
  due_date date
  completed_date date
  result varchar
  deficiencies text
  next_due_date date
}

// NEW — Source: "0 - Master Tableau Protection Incendie.xlsx" — confirmed real
// and fully populated. Captures STATIC per-building fire-system configuration
// (what is installed and what its current status is). Distinct from service_visit
// which tracks inspection EVENTS. Three vendor FKs (sprinkler, co2, current_fire)
// are nullable because not every building has all subsystems contracted separately.
Table building_fire_system {
  fire_system_id integer [primary key]
  building_id integer [ref: > building.building_id]
  panel_brand_model varchar
  panel_control_status varchar
  emergency_panel_status varchar
  smoke_detector_status varchar
  sprinkler_status varchar
  sprinkler_vendor_id integer [ref: > vendor_contact.vendor_id, note: 'nullable']
  hose_status varchar
  pressurization_pump_status varchar
  co2_status varchar
  co2_vendor_id integer [ref: > vendor_contact.vendor_id, note: 'nullable']
  dossier_link varchar
  current_fire_vendor_id integer [ref: > vendor_contact.vendor_id, note: 'nullable']
  corrective_actions_date date
  piezzo_status varchar
  notes text
}

// NEW — Source: live map, Building/Vendor deep-views — "Extermination
// tracked as a case that stays open across visits: pest type, which
// exterminator, when it was first reported, whether it is still under
// warranty and when that warranty expires." No source file exists yet
// (Extermination folder near-empty, no tracking).
Table pest_control_case {
  case_id integer [primary key]
  building_id integer [ref: > building.building_id]
  vendor_id integer [ref: > vendor_contact.vendor_id, note: 'nullable']
  pest_type varchar
  first_reported_date date
  warranty_active boolean
  warranty_expiry_date date
  notes text
}

Table emergency_access_code {
  access_code_id integer [primary key]
  building_id integer [ref: > building.building_id, note: 'nullable - some codes are zone-level not building-level']
  zone_name varchar
  code_type varchar
  code_value varchar
}

Table building_paint_spec {
  paint_spec_id integer [primary key]
  building_id integer [ref: > building.building_id]
  zone varchar
  surface_label varchar
  product_interior varchar
  product_exterior varchar
  manufacturer varchar // Sherwin William / Benjamin Moore
  // Real source confirmed via live map: "0 - Charte des couleurs de
  // peinture SIB" — a distinct file from the empty PEINTURE folder and
  // from the permission-blocked "Charte des couleurs SIB.xlsx" found
  // earlier in this project. Not yet pulled/ingested.
}

Table building_camera_system {
  camera_system_id integer [primary key]
  building_id integer [ref: > building.building_id]
  installed access_status_enum
  accessible_remote varchar
  functional varchar
  platform camera_platform
  ip_domain varchar
  port varchar
  username varchar
  password varchar [note: 'SENSITIVE - encrypt at rest']
}

// CHANGED — now references entrance, not building, directly. Source:
// live map, Building deep-view — "the intercom and key box now hang off
// the right door." Until entrance data exists, ingestion creates one
// synthetic entrance per building (see entrance table note above) so
// this FK is never left dangling.
Table building_intercom {
  intercom_id integer [primary key]
  entrance_id integer [ref: > entrance.entrance_id]
  brand varchar // Mircom / Akuvox
  dyndns_address varchar
  panel_model varchar
  is_master_building boolean
  keyless_code_general varchar
  keyless_code_maintenance varchar
  keyless_code_tenant varchar
}

Table building_access_control {
  access_control_id integer [primary key]
  building_id integer [ref: > building.building_id]
  brand varchar // Paradox / Akuvox
  panel_type varchar
  connection_option varchar
  panel_serial_or_ip varchar
  ip_module_password varchar [note: 'SENSITIVE']
  system_login varchar [note: 'SENSITIVE']
  system_password varchar [note: 'SENSITIVE']
}

// CHANGED — now references entrance, not building, directly. Same
// rationale/evidence as building_intercom above.
Table building_key_box {
  box_id integer [primary key]
  entrance_id integer [ref: > entrance.entrance_id]
  box_number_onsite varchar
  code varchar
  location_description text
  keyless_intercom_code varchar
  last_validated_date date
  last_validated_by varchar
}

Table building_telecom {
  building_id integer [primary key, ref: > building.building_id]
  internet_provider text           // ISP + account combined; format too inconsistent to split
  internet_broadcast_provider text // broadcast/cable provider + account
  tech_support_provider text       // IT/tech support vendor + contact
  telephone_provider text          // telephone provider + account (often multi-line for complexes)
}

Table pool_access_code {
  pool_code_id integer [primary key]
  building_id integer [ref: > building.building_id, null]  // nullable: codes may be complex-wide (OSEN pool codes have no per-building assignment)
  code_value varchar
  notes text
}

// NEW — Source: live map, Building/Unit deep-views — "furnaces, boilers,
// central heat pumps, elevators and freight elevators, the pool,
// barbecues and terraces — make, model, install year, seasonal shutdown
// and restart dates, and who maintains it." Also exists at unit level
// ("the unit's own heat pump... kept per apartment, not per lease") —
// modeled here as one table with both FKs nullable rather than two
// separate tables, since the live map describes identical fields for
// both cases; confirm this consolidation against real data once a
// source exists (currently: no source file for either level).
Table equipment {
  equipment_id integer [primary key]
  building_id integer [ref: > building.building_id, note: 'nullable - set when this is building-level equipment']
  unit_id integer [ref: > unit.unit_id, note: 'nullable - set when this is unit-level equipment, e.g. an apartment''s own heat pump']
  equipment_type equipment_type
  make varchar
  model varchar
  install_year integer
  seasonal_shutdown_date date
  seasonal_restart_date date
  maintained_by_vendor_id integer [ref: > vendor_contact.vendor_id, note: 'nullable']
  notes text
  // Expanded from "00. Follow-Ups - Boilers and Furnaces.xlsx". Source has parallel
  // column blocks for heating circuit and domestic-hot-water circuit — ingestion MUST
  // split each source row into 2 equipment rows (equipment_type = 'heating' or 'dhw'),
  // one per circuit. The 18 fields below map to those parallel blocks.
  criticality varchar
  assigned_vendor_id integer [ref: > vendor_contact.vendor_id, note: 'nullable'] // "Entrepreneur attitré"
  maintenance_frequency varchar
  last_maintenance_date date
  next_maintenance_date date
  maintenance_status varchar
  maintenance_note text
  urgency varchar
  action_priority varchar
  device_condition varchar
  replacement_priority varchar
  service_area varchar          // "desserte" — geographic/zone coverage served by this equipment
  component varchar             // "composante" — sub-component or circuit identifier within the unit
  quantity integer
  power varchar                 // "puissance" — kept varchar; units vary (kW, BTU, HP, etc.)
  efficiency varchar
  power_source varchar          // "alimentation" — electrical circuit, gas line, etc.
  energy_supplier varchar
}

Table unit {
  unit_id integer [primary key, note: 'natural key = Numéro unique d\'unité']
  building_id integer [ref: > building.building_id]
  rue varchar
  numero_appartement varchar
  grandeur varchar
}

Table lease {
  lease_id integer [primary key]
  unit_id integer [ref: > unit.unit_id]
  mois date
  debut_bail date
  fin_bail date
  date_fin_confirmee date
  date_limite_preavis date
  statut varchar
  langue_bail varchar
  droit_animaux boolean
  depot decimal
  loyer_de_base decimal
  loyer_total decimal
  mode_paiement_habituel varchar
  somme_due_restante decimal
  disponibilite_tableau_location varchar
  notes_collecte text
}

// CHANGED — this is now the single, canonical person record for the
// whole system, not just "current tenant on a lease." lease_id has been
// REMOVED (see tenancy_record below). Source: live map, Tenant deep-view
// — "A person the company deals with, kept once... Never linked directly
// [to a lease]... a roommate change, a lease assignment or a separation
// where one person stays is a new tenancy record — not a second copy of
// the person." Every place a name/phone/email used to be typed
// redundantly elsewhere in this schema (guarantor, maintenance_request
// caller, unit_turnover incoming/outgoing, tenant_equipment_loan,
// elevator_reservation — 7 locations total, confirmed during review) now
// references this table by FK instead.
Table tenant {
  tenant_id integer [primary key]
  nom_complet varchar
  telephone varchar
  courriel varchar
  telephone_international varchar
  ville varchar
  code_postal varchar
  informations_pour_make text
}

// NEW — junction between tenant and lease, replacing tenant.lease_id.
// Source: live map, Tenant/Lease deep-views — "who was on the lease and
// between which dates — one row per person per stretch of time, with the
// reason it changed." No source file exists yet: "Occupancy history —
// conceptual only, needs a new collection process." Until a real
// collection process exists, this can be backfilled approximately from
// Master Rent Roll snapshots (one tenancy_record per tenant per lease,
// capacity = named_on_lease, start/end = lease dates) as a stopgap.
Table tenancy_record {
  tenancy_id integer [primary key]
  lease_id integer [ref: > lease.lease_id]
  tenant_id integer [ref: > tenant.tenant_id]
  capacite tenancy_capacity
  start_date date
  end_date date
  reason_for_change text
}

// CHANGED — nom/telephone/courriel REMOVED, replaced by tenant_id FK.
// Source: live map, Tenant deep-view — "Guarantors point at a person the
// same way [as tenants do]." A guarantor is now a role a person plays on
// a specific lease, not a separately-typed name. NOTE: this specific
// field-level change is inferred from map wording rather than a directly
// quoted field list — confirm before treating as final.
Table guarantor {
  guarantor_id integer [primary key]
  lease_id integer [ref: > lease.lease_id]
  tenant_id integer [ref: > tenant.tenant_id]
  notes text
}

Table parking_assignment {
  parking_id integer [primary key]
  lease_id integer [ref: > lease.lease_id]
  mode varchar // bail/annexe/contrat
  location_type varchar // exterieur/interieur/couvert/garage
  count integer
  cost decimal
}

Table storage_assignment {
  storage_id integer [primary key]
  lease_id integer [ref: > lease.lease_id]
  mode varchar
  count integer
  cost decimal
}

Table unit_appliance {
  unit_appliance_id integer [primary key]
  lease_id integer [ref: > lease.lease_id]
  item varchar
  included boolean
  responsibility varchar
}

Table employee {
  employee_id integer [primary key]
  initials varchar [unique, note: '2-5 char code used in calendar ticket titles']
  nom_employe varchar
  telephone varchar
  courriel varchar
  temps_hebdo_ete decimal
  temps_hebdo_hiver decimal
  outils_fournis boolean
  disponibilites text
  sector_id integer [ref: > sector.sector_id, note: 'nullable; multi-sector employees captured in notes']
  role varchar
  employment_type employment_type [not null, default: 'unknown']
  is_active boolean [not null, default: true]
  auth_user_id uuid [note: 'nullable FK to auth.users; null until login provisioned']
  source_confidence source_confidence
  notes text
}

Table cleaning_task_checklist {
  checklist_id integer [primary key]
  building_id integer [ref: > building.building_id]
  format varchar // LEGACY — being superseded by format_type enum below; retained for backward compat
  element varchar
  frequency_per_week decimal
  hours_per_visit decimal
  season varchar
  total decimal
  freetext_content text // LEGACY — see raw_content below for the replacement
  // NEW — typed format classification; see checklist_format_type enum above
  format_type checklist_format_type
  // NEW — fallback content for day_rotation/single_line/freetext rows that do not
  // cleanly populate element/frequency_per_week/hours_per_visit/total columns
  raw_content text
}

Table building_employee_assignment {
  building_id integer [ref: > building.building_id]
  employee_id integer [ref: > employee.employee_id]
  weekly_hours_summer decimal
  weekly_hours_winter decimal
  access_notes text
}

Table laundry_contract {
  uln varchar [primary key]
  building_id integer [ref: > building.building_id, note: 'own address format (7th naming system) - confirmed still unreconciled per live map']
  payment_type payment_type
  contract_expiry date
  suite_count integer
  suite_to_set_ratio integer
  washer_count integer
  dryer_count integer
  wash_rate decimal
  dry_rate decimal
  loads_per_suite_pmpd decimal
  collections_pmpd decimal
  pay_rule_type pay_rule_type
  pay_rule_pct decimal
  min_commission decimal
  monthly_rental_fee decimal [note: 'only populated when pay_rule_type = rental']
  revenue_month decimal
  commission_month decimal
  commission_pct_month decimal
  revenue_per_set_month decimal
  commission_per_set_month decimal
  revenue_per_suite_month decimal
  commission_per_suite_month decimal
}

// CHANGED — tenant_name/phone/email REMOVED, replaced by tenant_id FK.
// Source: live map, Tenant deep-view — "Equipment on loan... points at
// the person the equipment was lent to."
Table tenant_equipment_loan {
  loan_id integer [primary key]
  unit_id integer [ref: > unit.unit_id]
  tenant_id integer [ref: > tenant.tenant_id]
  equipment_type varchar
  quantity integer
  status loan_status
  loan_start_date date
  expected_end_date date
  has_contract boolean
  notes text
  payment_status varchar
  payment_date date
  payment_amount decimal
}

Table vacant_unit_task {
  task_id integer [primary key]
  unit_id integer [ref: > unit.unit_id]
  priority integer
  access_status varchar
  listing_status varchar
  promised_lease_date date
  lease_start_date date
  future_tenant_name varchar
  future_tenant_contact varchar
  notes_free text
  internal_notes text
}

Table vacant_unit_task_item {
  item_id integer [primary key]
  task_id integer [ref: > vacant_unit_task.task_id]
  task_type task_item_type
  status varchar
  notes text
}

Table unit_turnover {
  turnover_id integer [primary key]
  unit_id integer [ref: > unit.unit_id]
  move_reason move_reason
  lease_end_date date
  move_out_confirmed_date date
  assignment_desired_date date
  move_out_time time
  move_out_email_sent_date date
  key_return_method varchar
  lease_start_date date
  move_in_confirmed_date date
  move_in_time time
  move_in_email_sent_date date
  key_pickup_method varchar
  intercom_status intercom_status
  cleaning_status varchar
  parking_remote_status varchar
  internet_transfer_current boolean
  internet_transfer_new boolean
  parking_stall_current varchar
  parking_stall_new varchar
  furnished_status_current varchar
  furnished_status_new varchar
  // CHANGED — incoming/outgoing tenant name/phone/email REMOVED, replaced
  // by FKs. Source: live map, Tenant deep-view — "Names the person moving
  // in and the person moving out, each pointing at their own record
  // rather than being retyped."
  incoming_tenant_id integer [ref: > tenant.tenant_id, note: 'nullable — set when tenant resolved by name match']
  outgoing_tenant_id integer [ref: > tenant.tenant_id, note: 'nullable — set when tenant resolved by name match']
  pre_departure_inspection_notes text
  general_notes text
  room_count varchar
  mattress_size varchar
  source_turnover_id integer [ref: > maintenance_request.request_id, note: 'optional - links informal intake column to real ticket']
  incoming_tenant_name_raw varchar [note: 'raw name for later FK-resolution pass']
  outgoing_tenant_name_raw varchar [note: 'raw name for later FK-resolution pass']
  outgoing_fin_bail date [note: 'nullable — backfilled from rent roll archive where a matching snapshot exists']
  outgoing_loyer numeric [note: 'nullable — backfilled from rent roll archive where a matching snapshot exists']
}

Table unit_turnover_furniture_item {
  furniture_item_id integer [primary key]
  turnover_id integer [ref: > unit_turnover.turnover_id]
  appliance_type varchar // internet/cuisiniere/refrigerateur/lave-vaisselle/laveuse/secheuse
  included_current boolean
  included_new boolean
}

Table unit_turnover_settlement {
  settlement_id integer [primary key]
  turnover_id integer [ref: > unit_turnover.turnover_id]
  deposit_amount_owed decimal
  deposit_received boolean
  deposit_refund_status varchar
  amount_owed_by_tenant decimal
  tal_dossier_open boolean
  edl_received boolean
  edl_satisfactory boolean
  notes text
}

// CHANGED — tenant_name/phone/email REMOVED, replaced by tenant_id FK.
// Source: live map, Tenant deep-view — "Elevator booking points at the
// person the move slot was reserved for."
Table elevator_reservation {
  reservation_id integer [primary key]
  building_id integer [ref: > building.building_id]
  elevator_label varchar
  date date
  unit_id integer [ref: > unit.unit_id]
  move_type move_type
  time_slot time_slot
  tenant_id integer [ref: > tenant.tenant_id]
  confirmed boolean
}

//////////////////// DYNAMIC / CALENDAR-SOURCED TABLES ////////////////////

Table maintenance_request {
  request_id integer [primary key]
  building_id integer [ref: > building.building_id]
  unit_id integer [ref: > unit.unit_id]
  // NEW — live map: "Most tickets link to a project through a matched
  // name, independently of the unit or building. A few buildings are not
  // matched yet, so a small number of tickets will show no project until
  // that is cleaned up." Kept nullable; project_label_raw preserves the
  // original unmatched text.
  project_id integer [ref: > project.project_id, note: 'nullable - matched by name, some rows unmatched']
  source_calendar varchar // MAIN - Calls / MAIN - Calls ST Majordome Québec
  urgency_tier urgency_tier
  sector_id integer [ref: > sector.sector_id, note: 'nullable - not all tickets resolve to a sector']
  // NEW — live map, ticket field list: "Equipment concerned, when it is
  // about a heat pump, boiler or elevator."
  equipment_id integer [ref: > equipment.equipment_id, note: 'nullable - only set when the ticket concerns a specific piece of equipment']
  banked_queue_date date
  triage_summary text
  delegable_status delegable_status
  delegable_notes text
  report_status report_status
  report_notes text
  duplicate_of_request_id integer [ref: > maintenance_request.request_id]
  addition_to_request_id integer [ref: > maintenance_request.request_id, note: 'nullable; ADDITION verdict (Guide rule 12); CHECK != request_id']
  synergy_request_ids integer[] // typed array; queryable with = ANY(synergy_request_ids)
  synergy_reason text
  unit_label varchar
  project_label varchar [note: 'legacy fallback for unmatched rows only']
  time_estimate_bucket time_estimate_bucket
  time_estimate_raw varchar
  complexity_tier complexity_tier
  // CHANGED — was a raw string only. Live map: "Now a real link on the
  // ticket when a job is outsourced, with the typed-in name kept beside
  // it for rows not yet matched." subcontractor_name kept as fallback.
  vendor_id integer [ref: > vendor_contact.vendor_id, note: 'nullable - set when the job is outsourced']
  subcontractor_name varchar [note: 'legacy fallback for unmatched rows only']
  proposed_assignee varchar [note: 'structurally always empty per Guide rule 37 - confirmed 2026-09']
  tenant_agreement_notes text
  other_notes text
  congestion_level congestion_level
  // CHANGED — caller_name/phone REMAIN as the raw fallback, but a real
  // FK is added. Live map: "Points at whoever called it in — often the
  // tenant, sometimes a neighbour, a family member or a staff member —
  // with the typed-in name kept beside it."
  caller_tenant_id integer [ref: > tenant.tenant_id, note: 'nullable - set when the caller is matched to a known person']
  caller_name varchar [note: 'legacy fallback for unmatched/non-tenant callers']
  caller_phone varchar [note: 'legacy fallback for unmatched/non-tenant callers']
  dispatched boolean
  work_performed text
  tenant_present boolean
  follow_up_expected boolean
  // NEW (2026-10-09) — Triage schema additions
  status request_status [not null, note: 'closed on all pre-2026-10-09 rows = backfill sentinel (predates app)']
  routing_rule varchar [note: 'A0–A5; records which rule fired; subcontractor_name records the decision']
  triage_started_at timestamp
  triage_model_version varchar // e.g. 'skill-v6.1/guide-v4.39'
}

// NEW (2026-10-09) — one row per model call attempt (including rejected/errored).
// Separate from data_provenance: provenance = WHERE a value came from;
// triage_log = WHAT the model was asked and WHAT it said.
Table triage_log {
  log_id            integer [primary key, increment]
  request_id        integer [not null, ref: > maintenance_request.request_id]
  attempted_at      timestamp [not null]
  model_version     varchar
  context_sent      jsonb     // assembled user message
  raw_response      text      // verbatim, before validation
  validation_result varchar   // accepted | rejected_<gate> | error | timeout
  validation_detail text
  latency_ms        integer
  input_tokens      integer
  output_tokens     integer
}

Table maintenance_followup_entry {
  followup_id integer [primary key]
  request_id integer [ref: > maintenance_request.request_id]
  entry_text text
  entry_date date
  entered_by_initials varchar
}

// Links a maintenance request to a prior ticket referenced in its historique_raw.
// relation_type = 'prior_ticket' is the only value currently produced (from historique_raw URLs);
// the column exists so other relation kinds can be added later.
Table maintenance_request_history {
  history_id integer [primary key]
  request_id integer [not null, ref: > maintenance_request.request_id]
  referenced_request_id integer [not null, ref: > maintenance_request.request_id]
  relation_type varchar [not null]

  indexes {
    (request_id, referenced_request_id, relation_type) [unique]
  }
}

Table maintenance_attachment {
  attachment_id integer [primary key]
  request_id integer [ref: > maintenance_request.request_id]
  drive_file_id varchar
  file_type varchar // photo / video
}

Table staff_shift {
  shift_id integer [primary key]
  employee_id integer [ref: > employee.employee_id]
  shift_type shift_type
  start_date date
  end_date date
}

Table on_call_schedule {
  on_call_id integer [primary key]
  employee_id integer [ref: > employee.employee_id]
  start_date date
  end_date date
  swap_notes text
}

Table waste_collection_schedule {
  schedule_id integer [primary key]
  building_id integer [ref: > building.building_id]
  collection_days varchar
  instructions_text text
  embedded_access_code varchar [note: 'confirmed rare - 1 of 12 buildings sampled had a code']
}

// SOURCE CORRECTED — live map states this comes from "Coordinator's
// Guide — recurring-task rules, not a spreadsheet," NOT from the
// Service Call Log (IA) calendar-recurrence file as we'd originally
// assumed while exploring the Maintenance drive. That file's actual
// mapping is still an open question — see review notes; it may turn out
// to be a source for service_visit instead, which currently has no
// source at all.
Table recurring_task_pattern {
  pattern_id integer [primary key]
  building_id integer [ref: > building.building_id]
  assigned_employee_id integer [ref: > employee.employee_id]
  task_type varchar
  recurrence_rule varchar
  standing_instructions text
}

Table data_provenance {
  provenance_id integer [primary key]
  target_table varchar [not null]
  target_pk integer [not null]
  target_column varchar [not null]
  source_type varchar [note: 'FT, MRR, CROSSWALK']
  source_drive_id varchar
  source_file_name varchar
  source_tab varchar
  source_row varchar
  source_column varchar
  raw_value text
  ingested_value text
  ingested_at timestamp
}
