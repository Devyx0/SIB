# Copy to .env.local (gitignored). These are the PUBLIC supabase-local
# defaults — same on every machine running `supabase start`, not secrets.
# For a remote deploy use the project URL and its anon/publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Production only (baked in at `vite build`). Leave unset for local/tunnel —
# Vite proxies /api same-origin. Set to the Railway backend public URL, no trailing slash.
#VITE_API_URL=https://sib-production-0fb2.up.railway.app

# Cloudflare Turnstile site key (public) for /public/demande.
#VITE_TURNSTILE_SITE_KEY=
# Space-separated parents allowed to iframe the form (dev Vite CSP). Prod: set same header on FE host.
#VITE_PUBLIC_INTAKE_FRAME_ANCESTORS=https://example.com
# Front desk phone shown when tenant lookup finds no unit (default: DISP 581-531-1011).
#VITE_FRONT_DESK_PHONE=581-531-1011

# DEMO ONLY — bottom-left impersonation picker (delete DemoUserSwitcher after demo).
# Same password as root DEV_SEED_PASSWORD for *@sib.local seed accounts.
#VITE_DEMO_USER_SWITCH=1
#VITE_DEMO_SEED_PASSWORD=

# Portfolio map tiles: any MapLibre style URL. Default is the free, keyless OpenFreeMap "positron" style.
#VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
